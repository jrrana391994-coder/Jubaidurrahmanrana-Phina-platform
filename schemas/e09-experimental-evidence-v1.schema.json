{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"PHINA E-09 Experimental Evidence Package v1",
  "type":"object",
  "additionalProperties":false,
  "required":["experimentId","technologyId","researchQuestion","claimOrHypothesis","objective","measurand","kpis","instrumentation","calibrationTraceability","units","rawMeasurements","rawArtifactRefs","environment","preconditions","protocolVersion","procedure","operatorOrSystem","timestamp","uncertainty","controls","acceptanceCriteria","repeatabilityReplication","independentCorroboration","analysis","provenance","humanSafetyReview"],
  "properties":{
    "experimentId":{"type":"string","minLength":1},
    "technologyId":{"type":"string","minLength":1},
    "researchQuestion":{"type":"string","minLength":1},
    "claimOrHypothesis":{"type":"string","minLength":1},
    "objective":{"type":"string","minLength":1},
    "measurand":{"type":"array","minItems":1,"items":{"type":"object","required":["name","unit"],"additionalProperties":true}},
    "kpis":{"type":"array","minItems":1},
    "instrumentation":{"type":"array","minItems":1},
    "calibrationTraceability":{"type":"object"},
    "units":{"type":"array","minItems":1},
    "rawMeasurements":{"type":"array","minItems":1,"items":{"type":"object","required":["value","unit"],"properties":{"value":{"type":"number"},"unit":{"type":"string","minLength":1}},"additionalProperties":true}},
    "rawArtifactRefs":{"type":"array","minItems":1},
    "environment":{"type":"object"},
    "preconditions":{"type":"object"},
    "protocolVersion":{"type":"string","minLength":1},
    "procedure":{"type":"string","minLength":1},
    "operatorOrSystem":{"type":"string","minLength":1},
    "timestamp":{"type":"string","minLength":1},
    "uncertainty":{"type":"object"},
    "controls":{"type":"object"},
    "acceptanceCriteria":{"type":"object"},
    "repeatabilityReplication":{"type":"object"},
    "independentCorroboration":{"type":"object"},
    "analysis":{"type":"object"},
    "provenance":{"type":"array","minItems":1,"items":{"type":"object","required":["class"],"properties":{"class":{"enum":["observed","reported","corroborated","inferred","projected","unknown"]}},"additionalProperties":true}},
    "humanSafetyReview":{"type":"object"}
  }
}